<Window x:Class="BarDock.ClockPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relojes y fecha"
        Icon="/icon.ico"
        Tag="dialog.title"
        Width="700"
        Height="720"
        MinWidth="620"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Foreground" Value="#555555" />
    </Style>
    <Style x:Key="Field" TargetType="Control">
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="PreviewBox" TargetType="Border">
      <Setter Property="Background" Value="#F4F4F4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Margin="0,0,0,10"
               TextWrapping="Wrap"
               Tag="dialog.intro"
               Text="El tamaño, la tipografía y el interlineado son comunes a toda la barra. El color es por zona horaria (y para la fecha). La fecha usa el día de la semana en vertical salvo que le pongas otro alias." />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top"
                   Tag="dialog.clocks"
                   Text="Relojes en la barra"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Añadir" Tag="dialog.add" Padding="12,4" Click="OnAddClock" />
          <Button Content="Quitar" Tag="dialog.remove" Padding="12,4" Margin="8,0,0,0" Click="OnRemoveClock" />
        </StackPanel>
        <ListBox x:Name="ClockList"
                 DisplayMemberPath="Display"
                 SelectionChanged="OnClockSelected"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
      </DockPanel>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Estilo general (relojes y fecha)" Tag="dialog.style" Style="{StaticResource SectionTitle}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="76" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Fuente" Tag="dialog.font" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="FontBox"
                      Grid.Row="0" Grid.Column="1"
                      Style="{StaticResource Field}"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      ToolTip="Vacío = la tipografía de la barra" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Negrita" Tag="dialog.bold" Style="{StaticResource FieldLabel}" />
            <CheckBox x:Name="BoldBox"
                      Grid.Row="1" Grid.Column="1"
                      Content="Texto en negrita"
                      Tag="dialog.boldText"
                      VerticalAlignment="Center"
                      Margin="0,0,0,7"
                      Checked="OnGlobalStyleChanged"
                      Unchecked="OnGlobalStyleChanged" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tamaño" Tag="dialog.size" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,7">
              <TextBox x:Name="SizeBox"
                       Width="60"
                       Height="26"
                       VerticalContentAlignment="Center"
                       TextChanged="OnGlobalStyleChanged"
                       ToolTip="Tamaño de la hora en DIPs (7-26)" />
              <TextBlock Text="7-26" Tag="dialog.sizeHint"
                         VerticalAlignment="Center"
                         Margin="10,0,0,0"
                         Foreground="#888888" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Interlineado" Tag="dialog.spacing" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,7">
              <TextBox x:Name="SpacingBox"
                       Width="60"
                       Height="26"
                       VerticalContentAlignment="Center"
                       TextChanged="OnGlobalStyleChanged"
                       ToolTip="Espacio entre las letras verticales" />
              <TextBlock Text="0.8 junto · 1.4 separado" Tag="dialog.spacingHint"
                         VerticalAlignment="Center"
                         Margin="10,0,0,0"
                         Foreground="#888888" />
            </StackPanel>
          </Grid>

          <Border Height="1" Background="#DDDDDD" Margin="0,10,0,12" />

          <TextBlock Text="Reloj seleccionado" Tag="dialog.selected" Style="{StaticResource SectionTitle}" />

          <StackPanel x:Name="EditorPanel">
            <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="76" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Zona" Tag="dialog.zone" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ZoneBox"
                      Grid.Row="0" Grid.Column="1"
                      Style="{StaticResource Field}"
                      SelectionChanged="OnZoneChanged" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Alias" Tag="dialog.alias" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,7">
              <TextBox x:Name="AliasBox"
                       Width="80"
                       Height="26"
                       MaxLength="4"
                       VerticalContentAlignment="Center"
                       TextChanged="OnAliasChanged"
                       ToolTip="Dos o tres letras; se muestran en vertical" />
              <TextBlock Text="2-3 letras en vertical" Tag="dialog.aliasHint"
                         VerticalAlignment="Center"
                         Margin="10,0,0,0"
                         Foreground="#888888" />
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Color" Tag="dialog.color" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,7">
              <TextBox x:Name="ColorBox"
                       Width="96"
                       Height="26"
                       VerticalContentAlignment="Center"
                       TextChanged="OnColorChanged"
                       ToolTip="Vacío = color del tema" />
              <Border x:Name="ColorSwatch"
                      Width="22" Height="22"
                      Margin="8,0,0,0"
                      CornerRadius="3"
                      BorderThickness="1"
                      BorderBrush="#999999" />
              <Button Content="Elegir…" Tag="dialog.pick" Height="26" Padding="10,0" Margin="8,0,0,0" Click="OnPickClockColor" />
              <Button Content="Quitar" Tag="dialog.clear" Height="26" Padding="10,0" Margin="6,0,0,0" Click="OnClearClockColor" />
            </StackPanel>
            </Grid>

            <Border Style="{StaticResource PreviewBox}">
              <StackPanel x:Name="PreviewHost"
                          Orientation="Horizontal"
                          Height="38"
                          VerticalAlignment="Center" />
            </Border>
          </StackPanel>

          <Border Height="1" Background="#DDDDDD" Margin="0,12,0,12" />

          <TextBlock Text="Fecha" Tag="dialog.date" Style="{StaticResource SectionTitle}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="76" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Alias" Tag="dialog.alias" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,7">
              <TextBox x:Name="DateAliasBox"
                       Width="80"
                       Height="26"
                       MaxLength="4"
                       VerticalContentAlignment="Center"
                       TextChanged="OnDateChanged"
                       ToolTip="Vacío = día de la semana (LUN, MAR...)" />
              <TextBlock Text="vacío = día de la semana (LUN, MAR...)" Tag="dialog.dateAliasHint"
                         VerticalAlignment="Center"
                         Margin="10,0,0,0"
                         Foreground="#888888" />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Color" Tag="dialog.color" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,7">
              <TextBox x:Name="DateColorBox"
                       Width="96"
                       Height="26"
                       VerticalContentAlignment="Center"
                       TextChanged="OnDateChanged"
                       ToolTip="Vacío = color del tema" />
              <Border x:Name="DateSwatch"
                      Width="22" Height="22"
                      Margin="8,0,0,0"
                      CornerRadius="3"
                      BorderThickness="1"
                      BorderBrush="#999999" />
              <Button Content="Elegir…" Tag="dialog.pick" Height="26" Padding="10,0" Margin="8,0,0,0" Click="OnPickDateColor" />
              <Button Content="Quitar" Tag="dialog.clear" Height="26" Padding="10,0" Margin="6,0,0,0" Click="OnClearDateColor" />
            </StackPanel>
          </Grid>

          <Border Style="{StaticResource PreviewBox}">
            <StackPanel x:Name="DatePreviewHost"
                        Orientation="Horizontal"
                        Height="38"
                        VerticalAlignment="Center" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancelar" Tag="dialog.cancel" Width="96" Margin="0,0,8,0" IsCancel="True" />
      <Button Content="Aceptar" Tag="dialog.ok" Width="96" IsDefault="True" Click="OnAccept" />
    </StackPanel>
  </Grid>
</Window>
